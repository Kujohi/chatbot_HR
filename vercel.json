{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/src/api/routes.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{frontend/**,database/**}"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/backend/(.*)",
      "destination": "backend/src/api/routes.py"
    },
    {
      "source": "/(.*)",
      "destination": "frontend/$1"
    }
  ]
}
